pipeline {

    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
       
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/krushnadeshmukh7/student-management.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
    }
}
