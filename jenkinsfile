pipeline {

    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
        terraform 'tf'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/krushnadeshmukh7/student-management.git'

                echo "Cloning is successful"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war',
                    fingerprint: true
                }
            }
        }

        stage('Upload to S3') {
            steps {
                sh '''
                    aws s3 cp target/student-management.war \
                    s3://krushna.online123123/
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build --no-cache -t student .
                    docker images
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region us-west-2 | \
                    docker login \
                    --username AWS \
                    --password-stdin 267850879086.dkr.ecr.us-west-2.amazonaws.com

                    docker tag student:latest \
                    267850879086.dkr.ecr.us-west-2.amazonaws.com/student:latest

                    docker push \
                    267850879086.dkr.ecr.us-west-2.amazonaws.com/student:latest
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                sh '''
                    terraform init
                '''
            }
        }

        stage('Terraform Plan') {
            steps {
                sh '''
                    terraform plan
                '''
            }
        }

        stage('Terraform Apply') {
            steps {
                sh '''
                    terraform apply -auto-approve
                '''
            }
        }

        stage('Verify EKS Cluster') {
            steps {
                sh '''
                    aws eks describe-cluster \
                    --name my-eks-cluster \
                    --region us-west-2

                    echo "EKS cluster is available"
                '''
            }
        }

        stage('Deployment on Kubernetes') {
            steps {
                sh '''
                    echo "Updating kubeconfig..."

                    aws eks update-kubeconfig \
                    --name my-eks-cluster \
                    --region us-west-2

                    echo "Checking Kubernetes nodes..."

                    kubectl get nodes

                    echo "Applying Kubernetes manifests..."

                    kubectl apply -f k8s/

                    echo "Waiting for Kubernetes deployment..."

                    sleep 30

                    echo "Pods:"
                    kubectl get pods

                    echo "Services:"
                    kubectl get svc -o wide

                    echo "Deployments:"
                    kubectl get deployments
                '''
            }
        }
    }
}